*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
venv.bak/
env.bak/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Testing and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs and local runtime files
*.log
*.tmp
*.temp

# Environment config
.env
.env.*

# Databases / generated data you don't want committed
*.sqlite3
*.db

# Application output directories
output/
outputs/

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Notebook checkpoints
.ipynb_checkpoints/
